DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your.domain.com
TIME_ZONE=UTC
# PostgreSQL (leave DB_NAME unset to use SQLite for local dev)
DB_NAME=lendhub
DB_USER=lendhub
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=14
# Set to 0 once repayments come from a payment-provider callback / staff entry only
ALLOW_SELF_REPORTED_REPAYMENTS=1
